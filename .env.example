# Set only in the server / Vercel environment. Never in static files or Git.
# Tinotech's Paystack merchant secret; use sk_test_ only on an explicitly test deployment.
PAYSTACK_SECRET_KEY=
# Generate a unique random secret (at least 32 characters) for this product.
CHATFOLD_UNLOCK_SECRET=
# Exact canonical origin, no path; HTTPS required outside localhost development.
CHATFOLD_APP_URL=https://chatfold.tinotech.co.za
# Explicit legacy origins kept for existing checkout cookies and receipt recovery.
# JSON array of exact origins; no wildcards, paths or arbitrary preview hosts.
CHATFOLD_ADDITIONAL_ORIGINS=["https://whatsapp-analyser-gilt-omega.vercel.app"]
# Optional staging override, never enable to accept real customer payments.
PAYSTACK_ALLOW_TEST_MODE=false
# Optional comma-separated receipt references suspended by the merchant.
CHATFOLD_REVOKED_REFERENCES=

# Original premium design from Tinotech private-assets/chatfold/keepsake.html.
# Set its complete UTF-8 contents as this SERVER-ONLY value. Do not commit it here.
CHATFOLD_TEMPLATE_HTML=
# Alternative for hosts with a per-variable length limit: gzip the same UTF-8
# file, then base64-encode it without line wrapping. Still a SERVER-ONLY secret.
# Use only one format; existing plaintext takes precedence. Maximum 5000 chars.
CHATFOLD_TEMPLATE_GZIP_BASE64=

# Alternative: central Tinotech gateway holds the sensitive merchant key.
# When configured, this mode takes precedence over PAYSTACK_SECRET_KEY.
TINOTECH_PAYMENTS_URL=
TINOTECH_PAYMENTS_TOKEN=
PAYSTACK_MODE=live
